{
  "name": "@deepseek-ai/dsh-coteccons-sso-msal",
  "description": "Coteccons SSO through Microsoft Entra ID with MSAL: browser sign-in with PKCE and a loopback redirect, token cache in the credential store",
  "version": "0.2.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/coteccons-sso-msal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-coteccons-sso": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-coteccons-sso": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-credentials-local": "workspace:*"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "@deepseek-ai/schemastery": "workspace:~",
    "open": "^11.0.0"
  }
}
